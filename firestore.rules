rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function staff() {
      return hasProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner','admin','editor'];
    }
    function owner() {
      return staff() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    function adminOrOwner() {
      return staff() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner','admin'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      // Bootstrap/update staff roles only from the trusted Owner session.
      allow create, update, delete: if owner();
    }

    match /articles/{articleId} {
      allow read: if (resource.data.status == 'published') || staff();
      allow create: if staff()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      // Approved staff may edit any article; only owner/admin may delete.
      allow update: if staff()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if adminOrOwner();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if adminOrOwner();
    }

    match /storeItems/{itemId} {
      allow read: if resource.data.status == 'published' || staff();
      allow create, update, delete: if adminOrOwner();
    }
  }
}
