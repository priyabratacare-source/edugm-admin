@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
:root{--blue:#2457d6;--blue2:#153fae;--ink:#14213d;--muted:#6b7892;--line:#e4eaf5;--bg:#f4f7fc;--white:#fff;--green:#16845b;--red:#b42318;--amber:#996500;--shadow:0 10px 35px rgba(26,57,112,.07)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.6 Poppins,system-ui,sans-serif}a{color:var(--blue);text-decoration:none}button,input,select,textarea{font:inherit}button,a{cursor:pointer}h1,h2,p{margin-top:0}h1{font-size:clamp(1.65rem,3vw,2.2rem);line-height:1.2;margin-bottom:8px}h2{font-size:1.05rem;margin-bottom:16px}p{margin-bottom:12px}.muted{color:var(--muted)}.tiny{font-size:11px}.eyebrow{font-size:10px;letter-spacing:.16em;font-weight:700;color:var(--blue);margin:0 0 8px}.hidden{display:none!important}
.auth-body{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(145deg,#edf3ff,#f8fbff)}.auth-card{width:min(100%,430px);background:#fff;padding:36px;border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.brand-mark{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:var(--blue);color:#fff;font-size:25px;font-weight:700;margin-bottom:20px}.auth-card h1{margin-bottom:8px}
.sidebar{position:fixed;inset:0 auto 0 0;width:250px;background:#fff;border-right:1px solid var(--line);padding:24px 16px;display:flex;flex-direction:column;z-index:10}.side-brand{display:flex;align-items:center;gap:10px;padding:0 10px 25px;font-weight:700;font-size:16px}.side-brand .brand-mark{width:38px;height:38px;margin:0;border-radius:12px;font-size:20px}.nav-label{font-size:10px;color:#99a5bb;font-weight:700;letter-spacing:.14em;padding:10px}.side-nav{display:grid;gap:5px}.side-nav a{display:flex;align-items:center;gap:11px;color:#5b6881;padding:11px 12px;border-radius:10px;font-weight:500}.side-nav a:hover,.side-nav a.active{background:#edf3ff;color:var(--blue)}.side-nav a span{width:20px;text-align:center}.side-bottom{margin-top:auto;border-top:1px solid var(--line);padding:15px 8px 0}.user-mini{font-size:11px;color:var(--muted);overflow-wrap:anywhere;margin-bottom:10px}.main-content{margin-left:250px;padding:34px;max-width:1600px}.mobile-top{display:none}.page-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:26px}.page-head .muted{margin-bottom:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);background:#fff;color:var(--ink);padding:10px 15px;border-radius:10px;font-weight:600;font-size:12px}.btn:hover{border-color:#b6c8f7}.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}.btn.primary:hover{background:var(--blue2)}.btn.danger{color:var(--red);border-color:#f0c8c4}.button-row{display:flex;gap:10px;flex-wrap:wrap}.stack{display:grid;gap:16px}
label{display:grid;gap:7px;font-size:12px;font-weight:600;color:#35435e}input,select,textarea{width:100%;min-width:0;border:1px solid #dce4f1;border-radius:10px;padding:11px 12px;background:#fff;color:var(--ink);outline:none}input:focus,select:focus,textarea:focus{border-color:#7797f2;box-shadow:0 0 0 3px #eaf0ff}textarea{resize:vertical;line-height:1.7}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;margin-bottom:20px;box-shadow:var(--shadow)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px}.panel-head h2{margin:0}.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}.stat-card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:19px;box-shadow:var(--shadow)}.stat-card span{display:block;color:var(--muted);font-size:12px}.stat-card strong{display:block;font-size:29px;margin-top:5px}
.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:720px}th,td{text-align:left;padding:13px 12px;border-bottom:1px solid #edf0f6;vertical-align:top;font-size:12px}th{color:#78849a;font-size:10px;text-transform:uppercase;letter-spacing:.08em;background:#fafbfe}td strong{display:block;font-size:12px}td small{color:var(--muted)}.pill{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:700;background:#edf3ff;color:var(--blue)}.pill.green{background:#e6f7ef;color:var(--green)}.pill.amber{background:#fff4d6;color:var(--amber)}.pill.red{background:#ffeded;color:var(--red)}.row-actions{display:flex;gap:6px;flex-wrap:wrap}.mini-btn{border:1px solid var(--line);background:#fff;border-radius:7px;padding:5px 8px;font-size:10px;color:var(--blue)}.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:18px}.notice{border-radius:10px;padding:11px 13px;background:#edf3ff;color:#294a91;font-size:12px;margin:12px 0}.notice.error{background:#fff0ee;color:var(--red)}.notice.success{background:#e9f8f0;color:var(--green)}.details-grid{display:grid;grid-template-columns:150px 1fr;gap:12px}.details-grid dt{color:var(--muted)}.details-grid dd{margin:0;font-weight:600}.mono{font-family:ui-monospace,monospace;overflow-wrap:anywhere}.check-list{padding-left:20px}.check-list li{padding:5px 0}.editor-toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.segmented{display:flex;background:#edf1f8;padding:4px;border-radius:10px;gap:4px}.mode-btn{border:0;background:transparent;border-radius:7px;padding:8px 11px;font-size:11px;color:var(--muted)}.mode-btn.active{background:#fff;color:var(--blue);box-shadow:0 1px 5px #dbe3f2}.editor-tools{display:flex;gap:7px;flex-wrap:wrap}.editor-tools button{border:1px solid var(--line);background:#fff;padding:6px 9px;border-radius:7px;font-size:11px}.code-editor{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;background:#101a2b;color:#d9e6ff;border-color:#263651;tab-size:2}
.category-item,.store-item,.user-item{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid #edf0f6}.category-item:last-child,.store-item:last-child,.user-item:last-child{border-bottom:0}.category-item strong,.store-item strong{display:block}.empty-state{padding:25px;text-align:center;color:var(--muted)}
@media(max-width:980px){.sidebar{width:215px}.main-content{margin-left:215px;padding:25px}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){.sidebar{position:static;width:auto;height:auto;padding:12px;display:block;border-right:0;border-bottom:1px solid var(--line)}.side-brand{padding:0 5px 10px}.side-nav{display:flex;overflow-x:auto;gap:5px}.side-nav a{white-space:nowrap;padding:8px 10px;font-size:11px}.nav-label,.side-bottom{display:none}.main-content{margin:0;padding:18px}.page-head{align-items:flex-start;flex-direction:column}.stats-grid{gap:10px}.stat-card{padding:14px}.stat-card strong{font-size:24px}.form-grid,.filters{grid-template-columns:1fr}.panel{padding:16px}.auth-card{padding:26px}.editor-toolbar{align-items:flex-start;flex-direction:column}}

/* EduGM Learning brand logo */
.auth-logo{display:block;width:min(100%,230px);height:100px;object-fit:contain;object-position:left center;margin:0 0 20px}.sidebar-logo{display:block;width:42px;height:42px;object-fit:contain;flex:0 0 42px;border-radius:10px}.side-brand{gap:10px}
